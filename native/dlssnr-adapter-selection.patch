+// OpenPlayer local extension: selection persists through internal shutdown/init,
+// but cannot mutate a live device. The worker exits before switching adapters.
+extern "C" __declspec(dllexport) int dlssnr_select_adapter(unsigned int low, int high, int enabled)
+{
+    if (g_device) return 0;
+    g_adapter_luid = {low, high};
+    g_explicit_adapter = enabled != 0;
+    return 1;
+}
+
+extern "C" __declspec(dllexport) unsigned long long dlssnr_adapter_luid()
+{
+    if (!g_device) return 0;
+    const LUID luid = g_device->GetAdapterLuid();
+    return (static_cast<unsigned long long>(static_cast<unsigned int>(luid.HighPart)) << 32) | luid.LowPart;
+}
